---
# Snapshot the full .data of each operator-managed ConfigMap.
# Any code change that alters rendered config values will fail these diffs.
#
# Expected data lives in 31_configmap_*.yaml files alongside this assert.
# envsubst expands only the listed shell variables ($NAMESPACE etc.),
# leaving Hadoop ${env.FOO} references untouched.
#
# The static vector.yaml is parameterised with Vector env-var refs like ${NAMESPACE}
# that must stay literal in the ConfigMap. Since envsubst '$NAMESPACE' would expand
# both `$NAMESPACE` (the core-site DNS, which we DO want substituted) and the literal
# `${NAMESPACE}` in vector.yaml, we temporarily mask the braces form around envsubst.
#
# Both sides are canonicalised to JSON via `yq -o=json`, so the snapshot files need
# not byte-match yq's YAML serialisation. The `*.log4j.properties` values end with an
# empty line (the operator-rs log4j template ends with one), which YAML writes as a
# `|+` block followed by a blank line; the snapshot files terminate that blank line
# with a comment so that the end-of-file-fixer pre-commit hook does not strip it.
#
# kuttl runs script commands with sh, not bash, so process substitution
# is unavailable. Temp files namespaced under $NAMESPACE are used for
# diff output to avoid collisions when tests run concurrently.
apiVersion: kuttl.dev/v1beta1
kind: TestAssert
timeout: 60
commands:
  #
  # ConfigMap data snapshot: hdfs-namenode-default
  #
  - script: |
      sed 's/${NAMESPACE}/__VECTOR_NS__/g' 31_configmap_hdfs-namenode-default.yaml | envsubst '$NAMESPACE' | sed 's/__VECTOR_NS__/${NAMESPACE}/g' | yq -o=json > /tmp/$NAMESPACE-expected.yaml
      kubectl -n $NAMESPACE get cm hdfs-namenode-default -o yaml | yq -o=json '.data' > /tmp/$NAMESPACE-actual.yaml
      if ! diff /tmp/$NAMESPACE-expected.yaml /tmp/$NAMESPACE-actual.yaml; then
        echo "ERROR: ConfigMap hdfs-namenode-default data drifted from snapshot."
        exit 1
      fi
  #
  # ConfigMap data snapshot: hdfs-datanode-default
  #
  - script: |
{% if test_scenario['values']['datanode-pvcs'] == '2hdd-1ssd' %}
      export DATANODE_DATA_DIR='[DISK]/stackable/data/hdd/datanode,[DISK]/stackable/data/hdd-1/datanode,[SSD]/stackable/data/ssd/datanode'
{% else %}
      export DATANODE_DATA_DIR='[DISK]/stackable/data/data/datanode'
{% endif %}
      sed 's/${NAMESPACE}/__VECTOR_NS__/g' 31_configmap_hdfs-datanode-default.yaml | envsubst '$NAMESPACE $DATANODE_DATA_DIR' | sed 's/__VECTOR_NS__/${NAMESPACE}/g' | yq -o=json > /tmp/$NAMESPACE-expected.yaml
      kubectl -n $NAMESPACE get cm hdfs-datanode-default -o yaml | yq -o=json '.data' > /tmp/$NAMESPACE-actual.yaml
      if ! diff /tmp/$NAMESPACE-expected.yaml /tmp/$NAMESPACE-actual.yaml; then
        echo "ERROR: ConfigMap hdfs-datanode-default data drifted from snapshot."
        exit 1
      fi
  #
  # ConfigMap data snapshot: hdfs-journalnode-default
  #
  - script: |
      sed 's/${NAMESPACE}/__VECTOR_NS__/g' 31_configmap_hdfs-journalnode-default.yaml | envsubst '$NAMESPACE' | sed 's/__VECTOR_NS__/${NAMESPACE}/g' | yq -o=json > /tmp/$NAMESPACE-expected.yaml
      kubectl -n $NAMESPACE get cm hdfs-journalnode-default -o yaml | yq -o=json '.data' > /tmp/$NAMESPACE-actual.yaml
      if ! diff /tmp/$NAMESPACE-expected.yaml /tmp/$NAMESPACE-actual.yaml; then
        echo "ERROR: ConfigMap hdfs-journalnode-default data drifted from snapshot."
        exit 1
      fi
